# Mode 3: Node Application in Docker, External MongoDB
# Place in root .env or pass as environment variables to docker compose

PORT=3000
HOST=0.0.0.0

# Option A: Cloud MongoDB Atlas URI (Recommended for Cloud Deployments)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/jobevents?retryWrites=true&w=majority

# Option B: Localhost MongoDB running directly on the host machine
# MONGO_URI=mongodb://host.docker.internal:27017/jobevents

WORKER_COUNT=2
WORKER_POLL_INTERVAL_MS=200
WORKER_LEASE_MS=15000
RETRY_BASE_DELAY_MS=500
RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=info
