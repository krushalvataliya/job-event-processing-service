# Mode 2: Full-Stack Containerized Deployment (MongoDB + API Server + Workers)
# Environment overrides if needed (compose defaults to internal container networking)

PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://mongo:27017/jobevents
WORKER_COUNT=2
WORKER_POLL_INTERVAL_MS=200
WORKER_LEASE_MS=15000
RETRY_BASE_DELAY_MS=500
RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=info
