# Mode 1: MongoDB in Docker, Node Server on Host
# Save as .env in project root when running Node.js services locally against Docker MongoDB

PORT=3000
HOST=0.0.0.0
MONGO_URI=mongodb://localhost:27017/jobevents
WORKER_COUNT=2
WORKER_POLL_INTERVAL_MS=200
WORKER_LEASE_MS=15000
RETRY_BASE_DELAY_MS=500
RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=info
